# Server
PORT=3000
NODE_ENV=development

# Supabase (PostgreSQL + Auth sync for Angular app)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Brevo (https://app.brevo.com) — uses the REST API (API keys tab), not SMTP keys
BREVO_API_KEY=your-brevo-api-key
# Must match a verified sender in Brevo → Senders, Domains & Dedicated IPs → Senders
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=TrustCom
# New Brevo accounts: request "transactional email" activation via Support and Tickets
# (relay.enabled must be true). Test with: npm run test:email

# Frontend URLs (used in email links)
CLIENT_URL=http://localhost:4200
API_URL=http://localhost:3000

# Token expiry (hours)
EMAIL_VERIFICATION_EXPIRES_HOURS=24
PASSWORD_RESET_EXPIRES_HOURS=1

# Local dev: if both Brevo and Supabase email fail, show verify link on screen (set false to surface errors instead)
# EMAIL_DEV_BYPASS=false

# Admin portal (must match admin-auth.service.ts credentials for suspend/reinstate API)
ADMIN_EMAIL=your-admin@email.com
ADMIN_PASSWORD=your-admin-password

# Firebase Admin (Phone OTP verification) — Firebase Console → Project settings → Service accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Phone OTP limits
OTP_EXPIRES_MINUTES=5
OTP_MAX_RESENDS=3
OTP_RESEND_COOLDOWN_SECONDS=60
